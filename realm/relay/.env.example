NONCE_SECRET=replace-with-output-of-openssl-rand-hex-32
RELAY_REALM=realm-relay
PERSIST_MESSAGES=false

# Record the source address of every STUN request, readable at
# localhost:8080/canary. Off by default: this turns the relay into something
# that logs who contacts it. Kept in memory only, cleared on restart.
CANARY_LOG=false
CANARY_KEEP=500
