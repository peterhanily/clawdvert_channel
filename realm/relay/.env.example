NONCE_SECRET=replace-with-output-of-openssl-rand-hex-32
RELAY_REALM=realm-relay
PERSIST_MESSAGES=false

# Shared-source token bucket. The burst allows normal TURN authentication and
# paged rr2 reads; the refill still bounds sustained traffic from one public IP.
RELAY_RATE_PER_SECOND=120
RELAY_RATE_BURST=240

# Conservative source default for Rendezvous V2 latest-value slots. Leave this
# false on a relay that does not serve rr2 clients. The published automatic-
# answer flow requires it to be explicitly true in that deployment's private
# .env. deploy-relay.sh preserves an existing .env, so shipping new source does
# not change the live value.
#
# Slot values are always memory-only, even when PERSIST_MESSAGES=true. Replacing
# or restarting the container clears them. The five-minute active and terminal
# windows match the browser's maximum automatic-answer capability and give a
# suspended mobile page time to observe or re-establish its ACK state.
RENDEZVOUS_V2_SLOTS=false
RENDEZVOUS_V2_MAX_SLOTS=1000
RENDEZVOUS_V2_MAX_SLOTS_PER_ROOM=64
RENDEZVOUS_V2_SLOT_TTL_MS=300000
RENDEZVOUS_V2_TERMINAL_TTL_MS=300000
RENDEZVOUS_V2_READER_LEASE_MS=60000

# Record the source address of every STUN request, readable at
# localhost:8080/canary. Off by default: this turns the relay into something
# that logs who contacts it. Kept in memory only, cleared on restart.
CANARY_LOG=false
CANARY_KEEP=500
